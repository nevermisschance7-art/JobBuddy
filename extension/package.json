{
  "name": "extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@jobbuddy/shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/chrome": "^0.1.12",
    "@types/node": "^22.18.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
