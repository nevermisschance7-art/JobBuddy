{
  "manifest_version": 3,
  "name": "JobBuddy",
  "version": "0.0.1",
  "description": "Job alerts and application autofill. You always press Submit yourself.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobBuddy"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"]
}
